# ---- 环境与凭据 ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.github/
.coverage
htmlcov/

# ---- 数据库与数据 ----
**/data/*.db
**/data/*.sqlite
**/*.sqlite3
**/data/artifacts/
**/data/scripts/

# 运行时生成的插件安装/归档目录（源码插件在 plugins/、agent/plugins/、master/plugins/，不受影响）
**/data/plugins/

# 仓库内置 pytest 插件源码；仅忽略其生成物
/plugins/pytest_plugin/__pycache__/
/plugins/pytest_plugin/**/*.pyc
/plugins/pytest_plugin.zip

# ---- 日志 ----
**/logs/
**/*.log

# ---- 前端 ----
web/node_modules/
web/dist/
web/.vite/

# ---- IDE / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.crt

# 代码审查临时目录
.review-tmp/
