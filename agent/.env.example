# ============================================================
# AETP Agent 环境变量示例
# Agent 是独立部署的组件，使用自己的 .env（复制本文件为 agent/.env 后修改）。
# 不要与 Master 的 .env 混用；本文件可提交，真实凭据不提交。
# 全部配置统一使用 AETP_AGENT_ 前缀，仅从本文件读取，不读取系统环境变量。
# ============================================================

# ---- Agent 标识 ----
# 新部署使用 v2；迁移期兼容运行才使用 legacy。
AETP_AGENT_PROFILE=v2
# 注册到 Master 的稳定节点 ID（全局唯一，与 MQTT client_id/topic 身份一致）。
# V2 留空时首次启动自动生成 ULID 并写回本文件；legacy 生成 agent-<UUID>。
AETP_AGENT_NODE_ID=
# 人类可读名称
AETP_AGENT_NAME=<台架名称>
# Master 的协议 sender.id，用于严格校验 register-ack
AETP_AGENT_MASTER_ID=aetp-master

# ---- MQTT 连接（与 Master 使用同一 Broker）----
AETP_AGENT_MQTT_HOST=<broker-host>
AETP_AGENT_MQTT_PORT=8883
AETP_AGENT_MQTT_USERNAME=<broker-username>
AETP_AGENT_MQTT_PASSWORD=<broker-password>
# MQTT identifier 必须全局唯一；留空时由 node_id 派生
AETP_AGENT_MQTT_CLIENT_ID=
# TLS CA 证书路径（相对路径以 .env 所在目录为基准）
AETP_AGENT_MQTT_CA_CERT_PATH=
AETP_AGENT_MQTT_USE_TLS=true

# ---- 本地账本 ----
# V2 profile 默认使用 sqlite:///data-v2/agent-v2.db，不读取 legacy 账本。
AETP_AGENT_LEDGER_URL=sqlite:///data-v2/agent-v2.db
# Agent 执行插件隔离安装目录（仅安装 Master 下发且 hash 校验通过的包）
AETP_AGENT_PLUGIN_DIR=data-v2/plugins
# 脚本本地缓存目录（下载后按 sha256 组织子目录，校验失败不落盘）
AETP_AGENT_SCRIPT_CACHE_DIR=data-v2/scripts

# ---- 节点能力（P5，§18.5：自动扫描 + 串口映射）----
# 系统（OS/内存/CPU）与语言运行时由代码自动扫描并随 node.register 上报，
# 无需手工配置。CAN 通道扫描为占位实现（台架侧按需实现）。
# 串口能力需要「功能名 -> 端口号」映射文件（相对路径以 .env 所在目录为基准）：
#   {"relay_board": "COM20", "psu": "COM30"}
# 未配置时尝试 Agent 运行目录下的 serial_ports.json；找不到则跳过串口能力。
# 上报前会逐个检查端口当前是否存在，不存在的端口标记为禁用。
AETP_AGENT_SERIAL_MAP_FILE=serial_ports.json

# ---- 执行与心跳 ----
# 单台架默认串行执行；并发需硬件隔离证明
AETP_AGENT_MAX_CONCURRENT_RUNS=1
# 心跳上报间隔（秒）
AETP_AGENT_HEARTBEAT_INTERVAL_S=5
# 等待注册回执的超时（秒）；超时后自动断开重连
AETP_AGENT_REGISTRATION_TIMEOUT_S=10
# ---- 运行日志 ----
AETP_AGENT_LOG_FILE=logs/agent.log
# 结构化 AgentLog JSONL（与普通文本日志分离，供本地归档与排障）
AETP_AGENT_STRUCTURED_LOG_FILE=logs/agent.jsonl
AETP_AGENT_LOG_LEVEL=INFO
AETP_AGENT_LOG_CONSOLE=true
AETP_AGENT_STRUCTURED_LOG_MAX_BYTES=10485760
AETP_AGENT_STRUCTURED_LOG_BACKUP_COUNT=5

# ---- 任务日志 spool ----
# 单批任务日志最大条数 / 最大缓冲秒数 / spool 最大字节数
AETP_AGENT_TASK_LOG_BATCH_SIZE=50
AETP_AGENT_TASK_LOG_FLUSH_S=1
AETP_AGENT_TASK_LOG_SPOOL_MAX_BYTES=104857600
