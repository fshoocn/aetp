# ============================================================
# AETP Master 环境变量示例
# 复制为 .env 后按需修改。所有 Master 配置统一使用 AETP_MASTER_ 前缀。
# 注意：不要将真实 .env 提交到版本库。
# ============================================================

# ---- HTTP ----
AETP_MASTER_HTTP_HOST=127.0.0.1
AETP_MASTER_HTTP_PORT=8000

# ---- 数据库 ----
# SQLite:      sqlite:///data/aetp.db
# MySQL:       mysql+pymysql://user:pass@host:3306/aetp
# PostgreSQL:  postgresql+psycopg2://user:pass@host:5432/aetp
AETP_MASTER_DATABASE_URL=sqlite:///data/aetp.db

# ---- JWT ----
# 生产环境必须替换为至少 32 字节的高熵随机值，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
AETP_MASTER_JWT_SECRET=change-me-to-a-random-32+byte-secret
# 访问令牌有效期（分钟）：短有效期 + 刷新令牌长会话
AETP_MASTER_JWT_EXPIRE_MINUTES=30
# 签发方与受众：解码时严格校验，防止令牌跨系统复用
AETP_MASTER_JWT_ISSUER=aetp-master
AETP_MASTER_JWT_AUDIENCE=aetp-web
# 刷新令牌有效期（天）：刷新时轮换，登出/改密/禁用账户时撤销
AETP_MASTER_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 日志 ----
AETP_MASTER_LOG_LEVEL=INFO
AETP_MASTER_LOG_FILE=logs/aetp.log
AETP_MASTER_LOG_CONSOLE=true

# ---- 迁移 ----
# 生产建议关闭（改为部署脚本显式执行 alembic upgrade head）
AETP_MASTER_AUTO_MIGRATE=true

# ---- 首次启动管理员（users 表为空时自动创建）----
AETP_MASTER_BOOTSTRAP_ADMIN_USERNAME=admin
AETP_MASTER_BOOTSTRAP_ADMIN_PASSWORD=change-me
AETP_MASTER_BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin

# ---- MQTT（Agent 上线后启用）----
AETP_MASTER_MQTT_HOST=
AETP_MASTER_MQTT_PORT=8883
AETP_MASTER_MQTT_USERNAME=
AETP_MASTER_MQTT_PASSWORD=
AETP_MASTER_MQTT_CLIENT_ID=aetp-master
AETP_MASTER_MQTT_CA_CERT_PATH=
AETP_MASTER_MQTT_USE_TLS=true
